# Build trees, anywhere, under any configuration suffix.
build*/
**/build*/
cmake-build*/
# scripts/verify_cuda.sh writes its per-configuration logs, harvested check counts
# and per-suite output beside the tree, named after the build directory. The
# directories themselves are covered by build*/ above; these are the loose files
# next to them, and the pattern has to admit the configuration suffix -- the gate
# builds `build-cuda-gate-release` and `-debug`, not `build-cuda-gate`.
build-cuda-gate*.log
build-cuda-gate*.txt
build-cuda-gate*.out

# Benchmark output.
results/
**/results/

# Test image output, written by the interop test and never read by it.
tests/output/

# Maintainer-only working files: the measurement log, the reference-device setup and
# the script that drives it, and the one-off measurement probes. One person's working
# notes and one person's hardware; a reader of this library needs none of them.
.local/
experiments/

# Python bytecode from the measurement scripts.
__pycache__/
