# Build trees, including the ones scripts/verify.sh creates for its four
# configurations. 2 067 of these files were committed once; the glob is broad on
# purpose so a new configuration cannot slip in the same way.
build/
build-*/
*/build/
*/build-*/
cmake-build-*/

# Benchmark output.
bincv-cpp/results/
results/

# Maintainer-only working files. The measurement log, the backlog, the reference-device
# setup and the script that drives it, and the one-off measurement probes are kept OUT of
# the repository: they are one person's working notes and one person's hardware, and a
# reader of this library needs none of them.
.local/
bincv-cpp/experiments/

# Written by test_opencv_interop, not read by it.
bincv-cpp/tests/output/
