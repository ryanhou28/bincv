# Build trees, anywhere, under any configuration suffix.
build*/
**/build*/
cmake-build*/
# scripts/verify_cuda.sh writes its configure and build logs beside the tree.
build-cuda-gate.*.log

# Benchmark output.
results/
**/results/

# Test image output, written by the interop test and never read by it.
tests/output/

# Maintainer-only working files: the measurement log, the reference-device setup and
# the script that drives it, and the one-off measurement probes. One person's working
# notes and one person's hardware; a reader of this library needs none of them.
.local/
experiments/
